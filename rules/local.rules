
# SENTINEL NIDS - Local Suricata Rules

# Alert on ICMP echo requests (ping)
alert icmp any any -> $HOME_NET any (msg:"SENTINEL ICMP Echo Request"; itype:8; sid:1000001; rev:1;)

# Alert on inbound TCP SYN packets
alert tcp any any -> $HOME_NET any (msg:"SENTINEL TCP SYN Observed"; flags:S; sid:1000002; rev:1;)
